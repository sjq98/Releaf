{
  "name": "releaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Releaf: agent-assisted warehouse workflows and custom SME business forms.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "jsep": "1.4.0",
    "lucide": "1.60.0",
    "pdfjs-dist": "6.4.299"
  }
}
