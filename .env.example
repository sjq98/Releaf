# Copy to .env and fill in a provider key and a model that supports strict JSON schema.
# Keep secrets on the server. Do not commit .env.
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible API base URL, including /v1 when required.
AI_BASE_URL=https://api.openai.com/v1
