# Copy to .env and fill in a provider key and a model that supports strict JSON schema.
# Keep secrets on the server. Do not commit .env.
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible API base URL, including /v1 when required.
AI_BASE_URL=https://api.openai.com/v1
# Separate floating assistant provider; the model must support function/tool calling.
# Saved Assistant provider settings take precedence over these values.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_PROVIDER_NAME=My provider
# Optional local server and SQLite database overrides.
# PORT=5174
# ORDER_DB=data/forms.sqlite
